PREFIX ohsp: <https://n4o-rse.github.io/osm-holywells-static/prop/>
PREFIX ohspq: <https://n4o-rse.github.io/osm-holywells-static/prop/qualifier/>
PREFIX ohsps: <https://n4o-rse.github.io/osm-holywells-static/prop/statement/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?item ?label (COUNT(?entry) AS ?shapes) (MIN(?since) AS ?first) (MAX(?since) AS ?last) WHERE {
  ?item ohsp:P111 ?entry ;
        rdfs:label ?label .
  ?entry ohsps:P111 ?wkt ;
         ohspq:P103 ?since .
  FILTER(LANG(?label) = "en")
  FILTER(!STRSTARTS(UCASE(STR(?wkt)), "POINT("))
}
GROUP BY ?item ?label
ORDER BY DESC(?shapes) ?label ?item
LIMIT 100
